rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.accessIssuer == 'cloudflare-access'
        && request.auth.token.accessEmail == 'arne.nys@ptiz.be'
        && request.auth.token.adminRole == 'super';
    }

    // School regulations remain publicly readable. All client-side writes require
    // the short-lived Firebase session minted from a verified Cloudflare Access JWT.
    match /schools/{schoolId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /versions/{versionId}/sections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Deny every collection or document path not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
